# Copy to .env (git-ignored) and set your own values.

# Comma-separated ticket key prefixes to show on each session card, e.g. ABC,OPS.
# A prefix matches with or without a hyphen (ABC-123, OPS0012345).
# Leave unset to match any Jira-style key (ABC-123).
TICKET_PREFIXES=ABC,OPS

# Port the dashboard listens on (127.0.0.1 only).
# SESSION_BOARD_PORT=7377

# How many days back the closed-sessions list goes.
# SESSION_BOARD_RECENT_DAYS=7
