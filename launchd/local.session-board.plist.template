<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The dashboard server. install.sh fills in {{BUN}}, {{DIR}} and {{LOGS}}. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.session-board</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{DIR}}/server.ts</string>
  </array>
  <!-- bun loads .env from the working directory. -->
  <key>WorkingDirectory</key><string>{{DIR}}</string>
  <key>RunAtLoad</key><true/>
  <!-- launchd restarts the server whenever it exits, at most once every 10 seconds. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{{LOGS}}/server.log</string>
  <key>StandardErrorPath</key><string>{{LOGS}}/server.log</string>
</dict>
</plist>
