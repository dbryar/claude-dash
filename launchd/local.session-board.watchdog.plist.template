<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The watchdog. install.sh fills in {{DIR}} and {{LOGS}}. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.session-board.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{DIR}}/watchdog.sh</string>
  </array>
  <!-- Every 30 seconds, and as soon as the code or .env changes. -->
  <key>StartInterval</key><integer>30</integer>
  <key>WatchPaths</key>
  <array>
    <string>{{DIR}}/server.ts</string>
    <string>{{DIR}}/index.html</string>
    <string>{{DIR}}/.env</string>
  </array>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{{LOGS}}/watchdog.log</string>
  <key>StandardErrorPath</key><string>{{LOGS}}/watchdog.log</string>
</dict>
</plist>
